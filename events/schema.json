{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "events/schema.json",
  "title": "Flood Explorer event bundle (contract v1)",
  "description": "Shape of events/<id>/event.json. After the freeze, only add optional fields. See docs/08-Plan-data.md section 3.",
  "type": "object",
  "required": ["id", "title", "kind", "bbox", "headline", "timeline", "layers", "sources"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "title": {"type": "string"},
    "place": {"type": "string"},
    "kind": {"type": "string", "enum": ["world", "story", "site", "live"]},
    "mock": {"type": "boolean", "description": "true = placeholder bundle, not real results"},
    "bbox": {"$ref": "#/$defs/bbox"},
    "headline": {
      "type": "object",
      "required": ["date", "sentence", "numbers"],
      "properties": {
        "date": {"$ref": "#/$defs/date"},
        "sentence": {"type": "string"},
        "numbers": {
          "type": "array", "minItems": 1, "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["label", "value", "unit"],
            "properties": {
              "label": {"type": "string"},
              "value": {"type": "number"},
              "unit": {"type": "string"}
            }
          }
        },
        "badge": {
          "type": "object",
          "required": ["text"],
          "properties": {"text": {"type": "string"}, "ref": {"type": "string"}}
        }
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "layers"],
        "properties": {
          "date": {"$ref": "#/$defs/date"},
          "stats": {"type": "object"},
          "layers": {"type": "array", "items": {"$ref": "#/$defs/layer_id"}}
        }
      }
    },
    "layers": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/layer_id"},
      "additionalProperties": {
        "type": "object",
        "required": ["group", "files", "bounds"],
        "properties": {
          "group": {"type": "string", "enum": ["base", "radar", "official", "result", "validation", "context"]},
          "sensor": {"type": "string"},
          "legend": {"type": ["string", "null"]},
          "label": {"type": "string"},
          "files": {
            "type": "object",
            "propertyNames": {"$ref": "#/$defs/date"},
            "additionalProperties": {"type": "string", "pattern": "^layers/[a-z0-9_]+_\\d{4}-\\d{2}-\\d{2}\\.png$"}
          },
          "bounds": {
            "type": "array", "minItems": 2, "maxItems": 2,
            "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}
          },
          "default": {"type": "boolean"},
          "source": {"type": "string"}
        }
      }
    },
    "validation": {"type": "object"},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "url", "credit"],
        "properties": {"name": {"type": "string"}, "url": {"type": "string"}, "credit": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "bbox": {
      "description": "[west, south, east, north] in degrees (EPSG:4326)",
      "type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}
    },
    "layer_id": {
      "type": "string",
      "enum": [
        "basemap", "photo",
        "nisar_rgb", "rcm_rgb", "rs1_rgb",
        "gfm_flood", "gfm_excluded", "dswx_s1", "gfm_refwater",
        "nisar_water", "nisar_floodveg", "nisar_adds", "combined",
        "rcm_water", "rs1_water", "agreement",
        "landcover", "people"
      ]
    }
  }
}
