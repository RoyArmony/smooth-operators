 "method": {
  "grid": "NISAR GCOV frequency B, 80 m (native); every source resampled onto it before analysis",
  "nisar": "detect.py v2, thresholds HH -13.0 / HV -18.0 dB (calibrated on clear optical days)",
  "flood": "water beyond permanent water (dark on ≥ 90 % of NISAR passes); area = pixels × 80 m × 80 m",
  "optical": "MODIS (250 m) least cloudy day within ± 3 d for 2000–2013; HLS (30 m) clearest within ± 5 d for 2026; none before 2000",
  "baselines": "GFM (Sentinel-1) exists from 2015, NASA OPERA DSWx-HLS from 2023: only on NISAR dates",
  "s1": "Sentinel-1 RTC gamma0 VV + VH (Planetary Computer), averaged onto the NISAR 80 m grid, 3×3 median; water = VV < -13.2 dB and VH < -18.9 dB (Otsu on 2025-09-29, same thresholds every year)"
 },
